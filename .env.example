PORT=3000
NODE_ENV=development

ADMIN_API_TOKEN=change_me_to_a_long_random_string

MEGAGROUP_LOGIN=your_login
MEGAGROUP_PASSWORD=your_password
MEGAGROUP_SITE_ID=123456
MEGAGROUP_CABINET_URL=https://cabinet.megagroup.ru
MEGAGROUP_SHOP_ID=123456

CDEK_URL=https://api.edu.cdek.ru/v2
CDEK_CLIENT_ID=client_id
CDEK_CLIENT_SECRET=client_secret
CDEK_WEBHOOK_SECRET=change_me_to_a_long_random_string

# Локально (docker-compose): redis://default:changeme@localhost:6379
# Upstash/managed Redis (TLS обязателен): rediss://default:<password>@<host>:6379
REDIS_URL=redis://default:changeme@localhost:6379

TELEGRAM_BOT_TOKEN=123456:your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Нужен только для self-ping (см. HealthPingService), чтобы бесплатный Render не
# засыпал по простою. На Render можно не задавать — там своя RENDER_EXTERNAL_URL.
SELF_URL=https://your-app.onrender.com
